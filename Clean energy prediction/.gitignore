# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Trained models -------------------------------------------------------
# Regenerated by `python train.py` (deterministic, < 1 min on a CPU).
# Remove this rule if you want to version the fitted boosters.
models/

# --- Data -----------------------------------------------------------------
# data/train.parquet and data/test.parquet ARE committed on purpose: the scripts
# that built them were removed, so they cannot be regenerated. Ignore only
# scratch or derived files you may add later.
data/*.csv
data/raw/
data/interim/
data/cache/

# --- Notebooks ------------------------------------------------------------
.ipynb_checkpoints/

