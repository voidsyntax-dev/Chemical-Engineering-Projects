FLOWSHEET
StructureContainer Reactions
  R_1 as ARTRxnCfg;
End
StructureContainer Chemistry
End
StructureContainer Structures
End
  BLOCKS("B1") as RCSTR3;
  BLOCKS("B6") as Pump;
  BLOCKS("VB") as Valve;
  BLOCKS("VE") as Valve;
  BLOCKS("VO") as Valve;
  FCB as PIDIncr;
  FCE as PIDIncr;
  LC as PIDIncr;
  TC as PIDIncr;
  DT as Dead_time;
  STREAMS("BE1") as MaterialStream;
  STREAMS("BENZENE") as MaterialStream;
  STREAMS("CSTRO") as MaterialStream;
  STREAMS("E1") as MaterialStream;
  STREAMS("ETHYLENE") as MaterialStream;
  STREAMS("OUTLET") as MaterialStream;
  STREAMS("PUMPO") as MaterialStream;
  S1 as ControlSignal;
  S2 as ControlSignal;
  S3 as ControlSignal;
  S4 as ControlSignal;
  S5 as ControlSignal;
  S6 as ControlSignal;
  S7 as ControlSignal;
  S8 as ControlSignal;
  S9 as ControlSignal;
  Connect BLOCKS("VB").Out_P and BLOCKS("B1").In_F with STREAMS("BE1");
  Connect BLOCKS("VB").In_F with STREAMS("BENZENE");
  Connect BLOCKS("B1").Out_P and BLOCKS("B6").In_F with STREAMS("CSTRO");
  Connect BLOCKS("VE").Out_P and BLOCKS("B1").In_F with STREAMS("E1");
  Connect BLOCKS("VE").In_F with STREAMS("ETHYLENE");
  Connect BLOCKS("VO").Out_P with STREAMS("OUTLET");
  Connect BLOCKS("B6").Out_P and BLOCKS("VO").In_F with STREAMS("PUMPO");
  Connect STREAMS("BENZENE").F via STREAMS("BENZENE").OutputSignal and FCB.PV via FCB.InputSignal with S1;
  Connect FCB.OP via FCB.OutputSignal and BLOCKS("VB").Pos via BLOCKS("VB").InputSignal with S2;
  Connect STREAMS("ETHYLENE").F via STREAMS("ETHYLENE").OutputSignal and FCE.PV via FCE.InputSignal with S3;
  Connect FCE.OP via FCE.OutputSignal and BLOCKS("VE").Pos via BLOCKS("VE").InputSignal with S4;
  Connect BLOCKS("B1").T via BLOCKS("B1").OutputSignal and DT.Input_ via DT.InputSignal with S5;
  Connect TC.OP via TC.OutputSignal and BLOCKS("B1").T_med via BLOCKS("B1").InputSignal with S6;
  Connect BLOCKS("B1").level via BLOCKS("B1").OutputSignal and LC.PV via LC.InputSignal with S7;
  Connect LC.OP via LC.OutputSignal and BLOCKS("VO").Pos via BLOCKS("VO").InputSignal with S8;
  Connect DT.Output_ via DT.OutputSignal and TC.PV via TC.InputSignal with S9;

CONSTRAINTS
  // Flowsheet variables and equations...
END


